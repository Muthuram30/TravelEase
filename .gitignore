# ============================================================
# TravelEase .gitignore
# ============================================================

# ---- Environment files (NEVER commit) ----
backend/.env
frontend/.env
.env

# ---- Node.js ----
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Vite build output ----
frontend/dist/
frontend/.vite/

# ---- PHP ----
backend/vendor/
backend/composer.lock

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE files ----
.vscode/
.idea/
*.suo
*.user

# ---- Logs ----
*.log
backend/logs/

# ---- Extracted ZIP files (not part of the new codebase) ----
stitch_extracted/
backend_extracted/
*.zip

# ---- PHP error logs ----
php_errorlog
