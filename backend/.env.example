# ============================================================
# TravelEase Backend — Environment Configuration
# ============================================================
# 1. Copy this file to .env  →  copy .env.example .env
# 2. Fill in your actual values below
# 3. NEVER commit .env to version control
# ============================================================

# ---- MySQL Database ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tourism_db
MYSQL_USER=root
MYSQL_PASSWORD=

# ---- React Frontend URL (for CORS) ----
# In development: http://localhost:5173
# In production: your actual domain
REACT_APP_URL=http://localhost:5173

# ---- Environment Mode ----
# Set to 'production' in HTTPS deployments to enable secure cookies
# Leave empty or 'development' for local HTTP testing
APP_ENV=development

# ---- Admin credentials ----
# Used by setup_admin.php to create/reset the admin user.
# Choose a strong password (min 12 chars, mix of letters + digits + symbols).
# Example: Tr@v3lE@se2026!Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- OmniRoute AI Chatbot (optional) ----
# Leave blank to use offline keyword-based responses.
# API key is NEVER sent to the browser — PHP proxy only.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=gpt-4o-mini

# ---- Contact ----
CONTACT_PHONE=9000000000

# ---- Setup token (protects setup_admin.php via browser) ----
# Change this to something secret before running via browser.
SETUP_TOKEN=travelease-setup-2026
